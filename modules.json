        "package_selection": {
          "github.com/faustbrian/go-log": "Use for standard slog logger construction and focused composable handlers without adopting a proprietary logging facade.",
          "github.com/faustbrian/go-log/handler/async": "Use for bounded asynchronous delivery with explicit overflow, flush, and shutdown semantics.",
          "github.com/faustbrian/go-log/handler/capture": "Use in tests for concurrency-safe record capture and semantic assertions.",
          "github.com/faustbrian/go-log/handler/redact": "Use for structural key and path redaction before values reach downstream handlers.",
          "github.com/faustbrian/go-log/handler/rotate": "Use for permission-enforced local file rotation when platform log streams are unavailable.",
          "github.com/faustbrian/go-log/handler/sample": "Use for explicit every-N or deterministic key-based sampling with observable counters.",
          "github.com/faustbrian/go-log/handler/stack": "Use for synchronous fan-out with inclusive per-handler level routing.",
          "github.com/faustbrian/go-log/otel": "Use to add OpenTelemetry trace and span correlation from a standard context without initializing a provider."
